{
  "expo": {
    "name": "Nec Reader",
    "slug": "nec-ebook-reader",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "necreader",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.aydinnasibli.nec",
      "supportsTablet": true,
      "infoPlist": {
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Book",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "org.idpf.epub-container",
              "com.aydinnasibli.nec.fb2",
              "com.aydinnasibli.nec.mobi",
              "com.aydinnasibli.nec.azw3",
              "public.plain-text",
              "public.zip-archive"
            ]
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "org.idpf.epub-container",
            "UTTypeDescription": "EPUB book",
            "UTTypeConformsTo": ["public.data", "public.composite-content"],
            "UTTypeTagSpecification": { "public.filename-extension": ["epub"], "public.mime-type": ["application/epub+zip"] }
          },
          {
            "UTTypeIdentifier": "com.aydinnasibli.nec.fb2",
            "UTTypeDescription": "FictionBook",
            "UTTypeConformsTo": ["public.xml"],
            "UTTypeTagSpecification": { "public.filename-extension": ["fb2"], "public.mime-type": ["application/x-fictionbook+xml", "application/x-fictionbook"] }
          },
          {
            "UTTypeIdentifier": "com.aydinnasibli.nec.mobi",
            "UTTypeDescription": "Mobipocket book",
            "UTTypeConformsTo": ["public.data"],
            "UTTypeTagSpecification": { "public.filename-extension": ["mobi", "prc"], "public.mime-type": ["application/x-mobipocket-ebook"] }
          },
          {
            "UTTypeIdentifier": "com.aydinnasibli.nec.azw3",
            "UTTypeDescription": "Kindle book",
            "UTTypeConformsTo": ["public.data"],
            "UTTypeTagSpecification": { "public.filename-extension": ["azw3", "azw"], "public.mime-type": ["application/vnd.amazon.mobi8-ebook", "application/vnd.amazon.ebook"] }
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B2848",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aydinnasibli.nec",
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ],
      "allowBackup": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            { "scheme": "content" },
            { "scheme": "file" },
            { "mimeType": "application/epub+zip" },
            { "mimeType": "application/x-fictionbook+xml" },
            { "mimeType": "application/x-fictionbook" },
            { "mimeType": "application/x-mobipocket-ebook" },
            { "mimeType": "application/vnd.amazon.ebook" },
            { "mimeType": "application/vnd.amazon.mobi8-ebook" },
            { "mimeType": "text/plain" },
            { "mimeType": "application/zip" },
            { "mimeType": "application/octet-stream" }
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B2848",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#141E38",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
